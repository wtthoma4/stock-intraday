# The configuration of the API. Copy this file to `api/.env` and change the values as necessary.
# The API reads `api/.env` when it starts. Real environment variables have priority over the file.
# The API stops at start if a value is not valid, and it shows all problems.

# development: shows the OpenAPI documentation at /docs. Use production on a server.
NODE_ENV=development
# 127.0.0.1 accepts connections only from this computer. A container must use 0.0.0.0.
HOST=127.0.0.1
PORT=5080
# fatal, error, warn, info, debug, trace or silent.
LOG_LEVEL=info
# The number of reverse proxies in front of the API: 0 with no proxy, 1 behind Nginx (Docker).
# Do not set a higher number than the real number of proxies. Then a client can avoid the rate limit with a false address.
TRUST_PROXY=0
# The browser origins that can call the API, separated by commas. The Vite development server uses port 5173.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# The maximum number of requests for each client IP address in one minute.
RATE_LIMIT_PER_MINUTE=60
# The time that a result stays in the cache, and the maximum number of symbols in the cache.
CACHE_TTL_SECONDS=300
CACHE_MAX_ENTRIES=1000

# Yahoo Finance. Yahoo refuses requests without the User-Agent of a browser. You must set this value.
YAHOO_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"
YAHOO_BASE_URL=https://query1.finance.yahoo.com
# The bar length. The daily summaries use 15-minute bars.
YAHOO_INTERVAL=15m
# The time limit for one attempt, the number of attempts after the first, and the first delay between attempts.
YAHOO_TIMEOUT_MS=10000
YAHOO_RETRY_ATTEMPTS=2
YAHOO_RETRY_BASE_DELAY_MS=250
# After this number of failures in a sequence, the API stops requests to Yahoo for the time below.
YAHOO_CIRCUIT_BREAKER_THRESHOLD=5
YAHOO_CIRCUIT_BREAKER_HALF_OPEN_AFTER_MS=30000

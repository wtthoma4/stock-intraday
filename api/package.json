{
  "name": "@stock-intraday/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node --enable-source-maps --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/big.js": "^7.0.0",
    "@types/node": "^22.20.5",
    "msw": "^3.0.3",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.2",
    "@scalar/fastify-api-reference": "^1.75.0",
    "big.js": "^7.0.1",
    "cockatiel": "^4.0.0",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "lru-cache": "^11.5.3",
    "openapi-types": "^12.1.3",
    "zod": "^4.6.7"
  }
}

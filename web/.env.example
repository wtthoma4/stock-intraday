# The configuration of the web application at build time. Copy this file to `web/.env` only if you must change a value.
# Vite puts these values into the JavaScript files when it builds the application.

# The origin of the API, for example https://api.example.com.
# Leave it empty if the page and the API have the same origin. This is true for the Vite proxy
# in development and for Nginx in Docker.
VITE_API_BASE_URL=

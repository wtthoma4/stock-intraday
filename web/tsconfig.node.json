// The TypeScript settings for `vite.config.ts`, which runs in Node.js when Vite or Vitest starts.
{
  // Use the strict settings that apply to all packages.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // `tsc -b` keeps its state in this file, so the next check is faster.
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    // The config file runs in Node.js, so it can use the Node.js types.
    "types": ["node"],
    // Permit imports with the `.ts` extension, as the Vite template writes them.
    "allowImportingTsExtensions": true,
    // Use only TypeScript syntax that a compiler can remove without a change to the JavaScript.
    "erasableSyntaxOnly": true,
    // The type check does not write files.
    "noEmit": true
  },
  "include": ["vite.config.ts"]
}
